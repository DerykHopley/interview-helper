{
  "name": "interview-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prototype": "vite --open /?variant=K1",
    "prototype:access": "vite --open /prototype/access",
    "prototype:dashboard": "vite --open /prototype/dashboard",
    "prototype:scenario-bank": "vite --open /prototype/scenario-bank",
    "prototype:backup": "vite --open /prototype/backup",
    "prototype:co-writing": "vite --open /prototype/co-writing",
    "prototype:dev-panel": "vite --open /prototype/dev-panel?dev=1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
