{
  // The only server-side code: holds the OpenRouter key and Access Token secret, and proxies model calls.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "interview-helper-worker",
  "main": "src/index.ts",
  // The newest date the Vitest Workers pool's bundled runtime supports (see PR #27).
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs: on for now. The Worker itself only ever logs token label, job, model and cost (tested in
  // worker/test/generate.test.ts). What Cloudflare records about each request by itself is checked on the
  // deployed Worker in #23.
  "observability": { "enabled": true },
  "vars": {
    // The web app's origin, allowed by CORS. Override per environment.
    "ALLOWED_ORIGIN": "http://localhost:5173",
    // Default model per job (spec #1, "Models and settings"). The Developer panel may pick another allowed model.
    "JOB_MODELS": {
      "question-generation": "openai/gpt-5-mini",
      "matching": "openai/gpt-5-mini",
      "match-reasons": "openai/gpt-5-mini",
      "co-writing": "openai/gpt-5-mini",
      // Feedback on an Answer, checked against its picked Scenario (#32).
      "feedback": "openai/gpt-5-mini",
      // The Readiness Report on a whole Interview (#56).
      "readiness-report": "openai/gpt-5-mini",
      // The Matcher Report's judge of Match reasons (#18): another company's model than the reasons writer's.
      "reason-judging": "google/gemini-3.8-flash"
    },
    // Limits per job, always sent to OpenRouter (#10). For reasoning models max_tokens covers reasoning and the reply
    // together, and a reply that runs out is empty but still billed, so these are generous; a request may ask for
    // fewer, never more. Low effort keeps gpt-5-mini quick and cheap. Tune once real calls run (#14, #17).
    "JOB_SETTINGS": {
      "question-generation": { "max_tokens": 4000, "reasoning_effort": "low" },
      "matching": { "max_tokens": 6000, "reasoning_effort": "low" },
      "match-reasons": { "max_tokens": 2000, "reasoning_effort": "low" },
      "co-writing": { "max_tokens": 4000, "reasoning_effort": "low" },
      "feedback": { "max_tokens": 3000, "reasoning_effort": "low" },
      // Medium effort: the one judgement over a whole Interview, asked for rarely (#56).
      "readiness-report": { "max_tokens": 8000, "reasoning_effort": "medium" },
      "reason-judging": { "max_tokens": 3000, "reasoning_effort": "low" }
    },
    // The only models the Worker forwards to: the job defaults above, plus the ones the Matcher Report compares
    // (COMPARED_MODELS in eval/src/reportPlan.ts, #18). A request may name any of them; nothing here changes which
    // model a job uses by default.
    "ALLOWED_MODELS": [
      "openai/gpt-5-nano",
      "openai/gpt-5-mini",
      "openai/gpt-5.4",
      "openai/gpt-4o-mini",
      "openai/gpt-6-luna",
      "google/gemini-3.8-flash",
      "google/gemma-4-31b-it",
      "anthropic/claude-haiku-4.5",
      "minimax/minimax-m2.7"
    ],
    // Decision jobs (#20): typed answers from a decision model, through /v1/decide only. Kept apart from the chat jobs
    // and models above, so a chat job can never pick Jev and a decision can never reach a chat model.
    "DECISION_JOBS": {
      // The Jev Matcher (#20), compared in the Matcher Report.
      "jev-matching": "typesafe/jev-1.13"
    },
    "DECISION_MODELS": ["typesafe/jev-1.13"]
  }
  // Secrets (never in this file): OPENROUTER_API_KEY and ACCESS_TOKEN_SECRET.
  // Local dev: copy worker/dev.vars.example to worker/.dev.vars (gitignored) and fill them in. (Don't name the example
  // .dev.vars.<anything>: Wrangler reads that as an environment's vars file and its empty values override the real ones.) Deployed: `wrangler secret put <NAME>`.
}
