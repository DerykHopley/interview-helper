{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "../node_modules/.tmp/worker-tsconfig.json.tsbuildinfo",
    "outDir": "../node_modules/.tmp/worker-tsconfig.json",
    "rootDir": ".."
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "../src/model-gateway/workerGateway.ts",
    "../src/model-gateway/ModelGateway.ts",
    "../src/matching/jevMatcher.ts",
    "../src/matching/llmMatcher.ts",
    "../src/matching/Matcher.ts",
    "../src/matching/promptVariants.ts",
    "../src/matching/shortIds.ts",
    "../shared"
  ]
}
